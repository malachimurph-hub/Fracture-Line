; Engine configuration file.
config_version=5

[application]

config/quit_on_go_back=false

config/name="Fracture Line"
config/description="FRACTURE LINE - original mobile RTS (M1 vertical slice)"
config/version="0.1.2-m1.2"
run/main_scene="res://ui/main_menu.tscn"
config/features=PackedStringArray("4.7", "Mobile")
boot_splash/bg_color=Color(0.07, 0.08, 0.1, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"

[autoload]

EventBus="*res://autoload/event_bus.gd"
Content="*res://autoload/content.gd"
Settings="*res://autoload/settings.gd"
UiScale="*res://autoload/ui_scale.gd"
SaveSystem="*res://autoload/save_system.gd"
GameSession="*res://autoload/game_session.gd"
AudioDirector="*res://autoload/audio_director.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/vsync/vsync_mode=1

[input_devices]

pointing/emulate_mouse_from_touch=true
pointing/emulate_touch_from_mouse=false

[internationalization]

locale/translations=PackedStringArray("res://locale/strings.en.translation")

[physics]

common/physics_ticks_per_second=20

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
renderer/rendering_method.web="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
scaling_3d/scale=0.75
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
environment/defaults/default_clear_color=Color(0.04, 0.05, 0.06, 1)
textures/default_filters/anisotropic_filtering_level=1

[editor]

export/convert_text_resources_to_binary=false

[debug]

file_logging/enable_file_logging=true
file_logging/max_log_files=3

[shader_globals]

fl_tex_quality={
"type": "float",
"value": 1.0
}
